# Port du serveur
PORT=5000

# Environnement (development | production)
NODE_ENV=development

# Connexion MongoDB Atlas
# Format : mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/todoapp?retryWrites=true&w=majority

# Secret JWT (générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d